### Laura publica un alojamiento
# @name publicacionLaura
POST http://127.0.0.1:3000/api/publicaciones
Content-Type: application/json
Authorization: Bearer {{loginLaura.response.body.$.token}}

{
  "tipo": "alojamiento",
  "id_municipio": 2,
  "categoria": "Cabaña",
  "titulo": "Cabaña entre viñedos",
  "descripcion": "Cabaña de madera para cuatro personas, rodeada de viñedos y con vista al desierto de La Candelaria.",
  "precio_base": 220000,
  "capacidad": 4,
  "direccion_exacta": "Vereda Sopotá, kilómetro 4",
  "latitud": 5.6412,
  "longitud": -73.5401,
  "normas": "No se permiten mascotas. Silencio después de las 10 p. m.",
  "hora_entrada": "15:00",
  "hora_salida": "11:00"
}

